#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define COLEMAK  0
#define NUM      1
#define PROG     2
#define GAME     3
#define EASY     4
#define FN       5
#define MOUSE    6
#define POWER    7
#define MODS     8
#define MODS_NAV 9
#define MODS_WIN_MAN 10

#define WIN_L LG(LC(LEFT))
#define WIN_R RG(RC(RIGHT))

&mmv {
        acceleration-exponent = <2>;  // 1
        time-to-max-speed-ms = <64>; // 300
        delay-ms = <0>;
        trigger-period-ms = <16>;      // 16
};

&msc {
        acceleration-exponent = <1>;  // 0
        time-to-max-speed-ms = <300>;  // 300
        delay-ms = <0>;
        trigger-period-ms = <16>;      // 16
};

/ {
        macros {
                ctoa: ctrl_to_alt {
                        compatible = "zmk,behavior-macro";
                        wait-ms = <0>;
                        tap-ms = <0>;
                        #binding-cells = <0>;
                        bindings
                                = <&macro_release &kp LCTRL>
                                , <&macro_press &atab>     
                                , <&macro_release &atab>
                                ;
                };

                sctoa: shift_ctrl_to_alt {      
                        compatible = "zmk,behavior-macro";
                        wait-ms = <0>;
                        tap-ms = <0>;
                        #binding-cells = <0>;
                        bindings
                                = <&macro_release &kp LCTRL>
                                , <&macro_press &astab>     
                                , <&macro_release &astab>
                                ;
                };

                lm: lm {
                        compatible = "zmk,behavior-macro-two-param";
                        wait-ms = <0>;
                        tap-ms = <0>;
                        #binding-cells = <2>;
                        bindings
                                = <&macro_param_1to1>
                                , <&macro_press &mo MACRO_PLACEHOLDER>
                                , <&macro_param_2to1>
                                , <&macro_press &kp MACRO_PLACEHOLDER>
                                , <&macro_pause_for_release>
                                , <&macro_param_2to1>
                                , <&macro_release &kp MACRO_PLACEHOLDER>
                                , <&macro_param_1to1>
                                , <&macro_release &mo MACRO_PLACEHOLDER>
                                ;
                };

                lmm: lmm {
                        compatible = "zmk,behavior-macro-one-param";
                        wait-ms = <0>;
                        tap-ms = <0>;
                        #binding-cells = <1>;
                        bindings
                                = <&macro_press &mo MODS>
                                , <&macro_param_1to1>
                                , <&macro_press &kp MACRO_PLACEHOLDER>
                                , <&macro_pause_for_release>
                                , <&macro_param_1to1>
                                , <&macro_release &kp MACRO_PLACEHOLDER>
                                , <&macro_release &mo MODS>
                                ;
                };

                lmmn: lmmn {
                        compatible = "zmk,behavior-macro-one-param";
                        wait-ms = <0>;
                        tap-ms = <0>;
                        #binding-cells = <1>;
                        bindings
                                = <&macro_press &mo MODS_NAV>
                                , <&macro_param_1to1>
                                , <&macro_press &kp MACRO_PLACEHOLDER>
                                , <&macro_pause_for_release>
                                , <&macro_param_1to1>
                                , <&macro_release &kp MACRO_PLACEHOLDER>
                                , <&macro_release &mo MODS_NAV>
                                ;
                };

                wm: wm {
                        compatible = "zmk,behavior-macro-one-param";
                        wait-ms = <0>;
                        tap-ms = <0>;
                        #binding-cells = <1>;
                        bindings
                                = <&macro_press &mo MODS_WIN_MAN>
                                , <&macro_param_1to1>
                                , <&macro_press &kp MACRO_PLACEHOLDER>
                                , <&macro_pause_for_release>
                                , <&macro_param_1to1>
                                , <&macro_release &kp MACRO_PLACEHOLDER>
                                , <&macro_release &mo MODS_WIN_MAN>
                                ;
                };

        };
        
        behaviors {
                kt_on: key_toggle_on_only {
                        compatible = "zmk,behavior-key-toggle";
                        #binding-cells = <1>;
                        display-name = "Key Toggle On";
                        toggle-mode = "on";
                }; 
                kt_off: key_toggle_off_only {
                        compatible = "zmk,behavior-key-toggle";
                        #binding-cells = <1>;
                        display-name = "Key Toggle Off";
                        toggle-mode = "off";
                };


                atab: alt_tab {
                        compatible = "zmk,behavior-tri-state";
                        #binding-cells = <0>;
                        bindings = <&kt_on LALT>, <&kp TAB>, <&kt_off LALT>;
                        ignored-key-positions = <12>;
                };


                astab: alt_shift_tab {
                        compatible = "zmk,behavior-tri-state";
                        #binding-cells = <0>;
                        bindings = <&kt_on LALT>, <&kp LS(TAB)>, <&kt_off LALT>;
                        ignored-key-positions = <0>;

                };
                

                ltt: layer_tap_tap_custom {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;    // <---[[moderate duration]]
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        flavor = "tap-preferred";
                        bindings = <&mo>, <&kp>;
                };
        
                ltc: layer_tap_custom {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;    // <---[[moderate duration]]
                        quick-tap-ms = <200>;
                        flavor = "hold-preferred";
                        bindings = <&mo>, <&kp>;
                };

                lmt: layer_mod_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;    // <---[[moderate duration]]
                        quick-tap-ms = <200>;
                        flavor = "hold-preferred";
                        bindings = <&lmm>, <&kp>;
                };

                lmnt: layer_mod_nav_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;    // <---[[moderate duration]]
                        quick-tap-ms = <200>;
                        flavor = "hold-preferred";
                        bindings = <&lmmn>, <&kp>;
                };
                
                wmt: layer_mod_win_man_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;    // <---[[moderate duration]]
                        quick-tap-ms = <200>;
                        flavor = "tap-preferred";
                        bindings = <&wm>, <&kp>;
                };

                mtc: mod_tap_custom {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <200>;    // <---[[moderate duration]]
                        quick-tap-ms = <200>;
                        flavor = "hold-preferred";
                        bindings = <&kp>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -------------------------------------------------------------------------------------
// | NUML |  Q  |  W  |  E  |  R  |  T  |        |  Y  |  U   |  I  |  O  |  P  | PRGL |
// | TAB  |  A  |  S  |  D  |  F  |  G  |        |  H  |  J   |  K  |  L  |  ;  |  '   |
// | EASY |  Zm |  X  |  C  |  V  |  B  |        |  N  |  M   |  ,  |  .  |  /  | GAME |
// | ALT  | DEL/LCTRL | BSPC/LSHFT | ESC/PROG |  | TAB/NUM | SPACE  | RET/POWER |  win |
                        bindings = <
   &tog NUM      &kp Q        &kp W          &kp F          &kp P           &kp B               &kp J        &kp L     &kp U          &kp Y   &kp SEMI &tog PROG
   &wmt LGUI TAB &kp A        &kp R          &kp S          &kp T           &kp G               &kp M        &kp N     &kp E          &kp I   &kp O    &kp SQT
   &tog GAME     &ltt MOUSE Z &kp X          &kp C          &kp D           &kp V               &kp K        &kp H     &kp COMMA      &kp DOT &kp FSLH &tog EASY
                               &lm MODS LALT &lmt LCTRL DEL &mtc LSHFT BSPC &ltc PROG ESC       &ltc NUM TAB &kp SPACE &ltc POWER RET &kp LGUI 
                        >;
                };

                num_layer {
                        bindings = <
   &trans &kp DOT   &kp N7            &kp N8          &kp N9 &kp DOT         &kp PG_UP &kp HOME &kp UP   &kp END   &kp C_VOL_UP &trans
   &trans &kp PLUS  &kp N4            &kp N5          &kp N6 &kp STAR        &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp C_VOL_DN &none
   &trans &kp MINUS &kp N1            &kp N2          &kp N3 &kp SLASH       &none     &none    &trans   &trans    &trans       &trans
                    &lm MODS_NAV LALT &lmnt LCTRL DEL &trans &ltc PROG N0    &trans    &trans   &trans   &trans
                        >;
                };

                prog_layer {
                        bindings = <
   &trans &kp EXCL  &kp AT    &kp HASH &kp DLLR  &kp PRCNT          &kp CARET &kp AMPS &kp STAR &kp PIPE  &none     &trans
   &trans &kp PLUS  &kp UNDER &kp LBRC &kp RBRC  &kp STAR           &kp TILDE &kp LPAR &kp RPAR &kp COLON &kp SEMI  &kp DQT
   &trans &kp MINUS &kp EQUAL &kp BSLH &kp LBKT  &kp SLASH          &kp GRAVE &kp RBKT &kp LT   &kp GT    &kp QMARK &trans
                    &trans    &trans   &kp ENTER &trans             &trans    &trans   &trans   &trans
                        >;
                };

                game_toggle {
                        bindings = <
   &kp ESC &kp Q &kp W     &kp E     &kp R     &kp T           &kp Y   &kp U     &kp I     &kp O     &kp O    &kp BSPC
   &kp TAB &kp A &kp S     &kp D     &kp F     &kp G           &kp H   &kp J     &kp K     &kp L     &kp SQT  &kp RET
   &trans  &kp Z &kp C     &kp C     &kp V     &kp B           &kp N   &kp M     &kp COMMA &kp DOT   &kp FSLH &trans
                 &kp LCTRL &kp LSHFT &kp SPACE &kp ESC         &mo NUM &kp SPACE &kp LGUI  &kp RCTRL
                        >;
                };
        
                easy_toggle {
// --------------------------------------              ---------------------------------------
// | ESC  |  Q  |  W  |  E  |  R  |  T  |              |  Y  |  U  |  I  |  O  |  P  | BSPC |
// | TAB  |  A  |  S  |  D  |  F  |  G  |              |  H  |  J  |  K  |  L  |  '  | ENTR |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |              |  N  |  M  |  ,  |  .  |  /  | SHFT |
//                    | Ctr | Alt | Spc | Fn |    | Fn | Spc | Win | Ctr |
                        bindings = <
   &kp ESC   &kp Q &kp W     &kp E    &kp R     &kp T           &kp Y  &kp U     &kp I     &kp O     &kp O    &kp BSPC
   &kp TAB   &kp A &kp S     &kp D    &kp F     &kp G           &kp H  &kp J     &kp K     &kp L     &kp SQT  &kp RET
   &kp LSHFT &kp Z &kp C     &kp C    &kp V     &kp B           &kp N  &kp M     &kp COMMA &kp DOT   &kp FSLH &kp RSHFT
                   &kp LCTRL &kp LALT &kp SPACE &mo FN          &mo FN &kp SPACE &kp LGUI  &kp RCTRL
                        >;
                };

                fn_layer {
                        bindings = <
   &kp TILDE &kp EXCL  &kp AT    &kp HASH &kp DLLR  &kp PRCNT          &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &kp PIPE
   &kp GRAVE &kp N1    &kp N2    &kp N3   &kp N4    &kp N5             &kp N6    &kp N7   &kp N8   &kp N9   &kp N0   &kp BSLH
   &trans    &kp COLON &kp UNDER &kp PLUS &kp MINUS &kp EQUAL          &kp LBRC  &kp RBRC &kp LBKT &kp RBKT &kp SEMI &tog EASY
                       &trans    &trans   &trans    &trans             &trans    &trans   &trans   &trans
                        >;
                };

                mouse_layer {
                        bindings = <
   &trans &trans &kp HOME &kp UP   &kp END   &kp PG_UP                 &msc MOVE_UP   &msc MOVE_LEFT &mmv MOVE_UP   &msc MOVE_RIGHT &trans &trans
   &trans &trans &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN                 &msc MOVE_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none  &none
   &trans &trans &trans   &trans   &trans    &trans                    &mkp MB5 &mkp MB4       &none          &none           &none  &trans
                          &kp LALT &kp LCTRL &trans    &trans   &trans &mkp MB1 &mkp MB2 &tog MOUSE    
                        >;
                };

                power_layer {
                        bindings = <
   &kp F1      &kp F2 &kp F3         &kp F4        &kp F5             &kp F6                       &kp F7 &kp F8      &kp F9     &kp F10    &kp F11        &kp F12             
   &bootloader &none  &bt BT_CLR     &bt BT_PRV    &bt BT_NXT         &none                        &none  &kp C_PREV  &kp C_PP   &kp C_NEXT &none          &bootloader
   &sys_reset  &none  &bt BT_CLR_ALL &none         &none              &none                        &none  &to COLEMAK &bt BT_PRV &bt BT_NXT &bt BT_CLR_ALL &sys_reset
                                     &kp LALT      &lmt LCTRL LC(DEL) &mtc LSHFT LC(BSPC) &trans   &trans &trans &trans      &trans             
                        >;
                };

                mod_layer {
                        bindings = <
   &ctoa      &kp Q &kp W &kp F  &kp P  &kp B                  &kp J  &kp L  &kp U     &kp Y   &kp SEMI &none
   &sctoa     &kp A &kp R &kp S  &kp T  &kp G                  &kp M  &kp N  &kp E     &kp I   &kp O    &kp SQT
   &kp LSHFT  &kp Z &kp X &kp C  &kp D  &kp V                  &kp K  &kp H  &kp COMMA &kp DOT &kp FSLH &trans
                         &trans &trans &trans &trans   &trans &trans &trans &trans
                        >;
                };

                mod_nav_layer {
                        bindings = <
   &ctoa      &kp Q &kp W &kp F  &kp P  &kp B                  &trans &trans &trans &trans &trans &none
   &sctoa     &kp A &kp R &kp S  &kp T  &kp G                  &trans &trans &trans &trans &trans &none
   &kp LSHFT  &kp Z &kp X &kp C  &kp D  &kp V                  &trans &trans &trans &trans &trans &trans
                         &trans &trans &trans &trans   &trans &trans &trans &trans
                        >;
                };
                
                mod_win_man_layer {
                        bindings = <
   &ctoa      &kp Q &kp W &kp F  &kp P  &kp B                  &kp LC(UP)   &kp LA(LEFT) &kp UP   &kp LA(RIGHT) &kp C_VOL_UP &trans
   &sctoa     &kp A &kp R &kp S  &kp T  &kp G                  &kp LC(DOWN) &kp LEFT     &kp DOWN &kp RIGHT     &kp C_VOL_DN &none
   &kp LSHFT  &kp Z &kp X &kp C  &kp D  &kp V                  &trans       &trans       &trans   &trans        &trans       &trans
                         &trans &trans &trans &trans   &trans &trans &trans &trans
                        >;
                };
        };
};